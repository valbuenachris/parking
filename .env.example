# Variables de entorno de ejemplo.
# Copia este archivo como .env y ajusta los valores si lo necesitas.

# Ruta del archivo SQLite dentro del contenedor (docker-compose la define).
PARQUEADERO_DB=/datos/parqueadero.db

# Token compartido que protege la API del panel. Obligatorio (mínimo 32
# caracteres): si falta o es más corto, la API responde 503 en los endpoints
# protegidos. No dejes un valor por defecto; genera uno propio, por ejemplo con
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
PARQUEADERO_TOKEN=

# Orígenes permitidos por CORS, separados por coma (no se permite "*").
PARQUEADERO_ORIGENES=https://localhost,http://localhost:5173

# Límite de tasa: MAXIMO/VENTANA_SEGUNDOS (0 desactiva el límite). Se recorta a
# un máximo de 100000 peticiones por ventana de hasta 86400 segundos.
PARQUEADERO_RATE_LIMIT=120/60

# Cabecera HSTS que envía nginx sobre HTTPS. En desarrollo se queda en un
# max-age corto (p. ej. "max-age=300") y solo se alarga cuando el HTTPS sea
# estable. En producción, con PARQUEADERO_ENTORNO=produccion y sin definir esta
# variable, se usa "max-age=31536000; includeSubDomains".
PARQUEADERO_HSTS=max-age=300

# Entorno del despliegue: "desarrollo" (por defecto) o "produccion". En
# producción no se genera un certificado autofirmado y el HSTS por defecto es
# largo.
PARQUEADERO_ENTORNO=desarrollo

# Subredes (separadas por coma) de las que se acepta la cabecera
# X-Forwarded-For. Fuera de ellas se usa la IP del peer TCP, de modo que una
# X-Forwarded-For forjada no burla el limitador.
# En el despliegue del VPS se usa el override con red 172.30.0.0/16; en ese caso
# define PARQUEADERO_PROXIES=172.30.0.0/16 para que el limitador vea la IP real.
PARQUEADERO_PROXIES=172.28.0.0/16

# Nombres adicionales para el SAN del certificado autofirmado de desarrollo
# (además de localhost y loopback), p. ej. "DNS:parqueadero,IP:192.168.1.10".
# En el VPS actual: IP:15.204.10.78
PARQUEADERO_CERT_SAN=

# URL de la API usada por el frontend durante el desarrollo con Vite.
# En producción el frontend la resuelve por el proxy de nginx (/api).
VITE_API_URL=/api
