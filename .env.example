# Variables de entorno de ejemplo.
# Copia este archivo como .env y ajusta los valores si lo necesitas.

# Ruta del archivo SQLite dentro del contenedor (docker-compose la define).
PARQUEADERO_DB=/datos/parqueadero.db

# Token compartido que protege la API del panel. Obligatorio: si falta, la API
# responde 503 en los endpoints protegidos. Genera uno propio, por ejemplo con
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
PARQUEADERO_TOKEN=cambia-este-token

# Orígenes permitidos por CORS, separados por coma (no se permite "*").
PARQUEADERO_ORIGENES=http://localhost:8080,http://localhost:5173

# Límite de tasa: MAXIMO/VENTANA_SEGUNDOS (0 desactiva el límite).
PARQUEADERO_RATE_LIMIT=120/60

# URL de la API usada por el frontend durante el desarrollo con Vite.
# En producción el frontend la resuelve por el proxy de nginx (/api).
VITE_API_URL=/api
